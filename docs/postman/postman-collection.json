    "name": "AutoPartSmart API - PTM-06 (JWT Auth & OWASP Anti-BOLA)",
    "description": "Koleksi Postman lengkap untuk pengujian fungsional dan keamanan OWASP API Top 10 (2023) pada backend AutoPartSmart. Mencakup skenario sukses (200/201) dan alur kegagalan (400/401/403/404/422).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "attacker_token",
      "value": "",
