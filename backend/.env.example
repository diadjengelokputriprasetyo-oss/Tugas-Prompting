# AutoPartSmart Backend Environment Template
# Salin berkas ini ke .env sebelum menjalankan aplikasi (cth: cp .env.example .env)

# Application
PROJECT_NAME="AutoPartSmart Backend API"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / SQLite)
# Contoh SQLite (Lokal): sqlite:///./autopartsmart.db
# Contoh PostgreSQL (Produksi): postgresql://user:password@localhost:5432/autopartsmart_db
DATABASE_URL=sqlite:///./autopartsmart.db

# JWT Authentication Security (Wajib diganti pada lingkungan produksi!)
SECRET_KEY=ganti_dengan_random_secret_key_minimal_32_karakter_rahasia_anda
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Model & Artifact Paths
MODEL_PATH=models/knn_model.joblib
SCALER_PATH=models/scaler.joblib

# Security & Upload Resource Limits (OWASP API4 Mitigation)
MAX_FILE_SIZE_MB=5
